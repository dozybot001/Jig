{
	"name": "@tenonai/jig",
	"version": "1.0.3",
	"description": "An AI-native multi-agent workbench",
	"keywords": [
		"agent",
		"ai",
		"multi-agent",
		"workbench",
		"cli"
	],
	"license": "MIT",
	"author": "Tenon AI (https://tenonai.cn/)",
	"homepage": "https://tenonai.cn/products/jig/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dozybot001/Jig.git"
	},
	"bugs": {
		"url": "https://github.com/dozybot001/Jig/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"jig": "bin/jig.js"
	},
	"files": [
		"bin",
		"dist",
		"web/dist",
		"THIRD-PARTY-NOTICES.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit -p . && tsc --noEmit -p web && npm test",
		"test": "node --test \"test/**/*.test.ts\"",
		"format": "biome check --write .",
		"build:web": "vite build --config web/vite.config.ts",
		"watch:web": "vite build --config web/vite.config.ts --watch",
		"relay:publish": "bash deploy/relay/publish.sh",
		"build": "tsc -p tsconfig.build.json && npm run build:web && node scripts/notices.mjs",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.2.1",
		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@hono/node-server": "2.1.6",
		"@napi-rs/keyring": "2.1.2",
		"diff": "9.0.0",
		"hono": "4.13.17",
		"htmlparser2": "12.0.0",
		"uqr": "0.1.3",
		"ws": "8.22.0"
	}
}
