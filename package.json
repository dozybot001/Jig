	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"jig": "./src/cli/main.ts"
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit -p . && tsc --noEmit -p web && npm test",
		"test": "node --test \"test/**/*.test.ts\"",
		"format": "biome check --write .",
		"build:web": "vite build --config web/vite.config.ts",
		"watch:web": "vite build --config web/vite.config.ts --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
