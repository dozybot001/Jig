		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@hono/node-server": "2.1.6",
		"@napi-rs/keyring": "2.1.2",
