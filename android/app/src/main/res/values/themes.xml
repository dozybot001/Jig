<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: Jig's paper colour, light or dark with the system. -->
    <style name="Theme.Jig" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#FFFFFF</color>
    <color name="ink">#0D0D0D</color>
</resources>
