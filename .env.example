# Yew reads no .env file. These are the environment variables it looks at, with what each one does;
# set them in your shell, or in the service that runs Yew. No real values belong in this file.

# --- yew (the local service and the command line) ---
# Yew's data folder. Default: ~/.yew
YEW_HOME=
# "off" keeps API keys in memory instead of the system keychain, for a Yew started to try something out.
YEW_KEYCHAIN=
# "off" starts Yew without the browser and computer-use MCP servers it comes with.
YEW_MCP_BUILTIN=
# Any non-empty value turns colors off in command-line output.
NO_COLOR=
# Values written as ${NAME} in mcp.json are taken from the environment Yew runs in.

# --- the relay (relay/main.ts), on the server only ---
# Port and address to listen on. Defaults: 8790 and 0.0.0.0
PORT=
HOST=
# Connections held at once. Default: 4000
MAX_CONNECTIONS=
# 1 behind the reverse proxy: the client address is the last value of X-Forwarded-For.
TRUST_PROXY=
# Apple's push signing key (.p8) as a file path, its key id and the team id. Without them, push is off.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
# The app's bundle id. Default: cn.tenonai.apps.yew
APNS_TOPIC=
