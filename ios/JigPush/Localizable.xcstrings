{
  "sourceLanguage": "en",
  "strings": {
    "push.budget.reached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped: today's spending reached the daily limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的费用到了每日上限，已停下"
          }
        }
      }
    },
    "push.budget.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's spending passed 80% of the daily limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的费用超过了每日上限的 80%"
          }
        }
      }
    },
