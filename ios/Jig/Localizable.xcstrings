    "An AI-native multi-agent workbench": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 原生的多 Agent 工作台"
          }
        }
      }
    },
    "An AI-native multi-agent workbench. Jig organizes agent sessions the Session Engineering way: you deal only with the main conversation, and everything that needs your approval or decision comes to the approval center. The sessions run in Jig on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 原生的多 Agent 工作台。Jig 按 Session Engineering 的做法组织 Agent 会话：你只对接主对话，要你授权和决定的事都汇到审批中心。会话跑在你 Mac 上的 Jig 里。"
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答"
